# ============================================================================
# DailyNest — Environment Variables
# ============================================================================
# Copy this file to `.env.local` and fill in real values.
# `.env.local` is git-ignored and must NEVER be committed.

# --- Supabase (required) ---
# From: Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. NEVER expose to the browser. Used for privileged server
# operations (owner bootstrap, admin queries) — safe because Row Level
# Security still applies to every query unless explicitly bypassed.
SUPABASE_SERVICE_ROLE_KEY=

# --- App URL (required in production) ---
# The canonical URL this site is served from, e.g. https://dailynest.vercel.app
# Used for auth email redirects and absolute links in notifications.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Owner bootstrap (required for first-run owner account creation) ---
# Read ONLY on the server. Used exactly once (idempotent) to provision the
# initial owner account. The owner is forced to change this password after
# the first login. Leave blank to disable auto-bootstrap; if left blank and
# no owner exists, the /store-control-7x9/setup page explains how to
# configure it. Do NOT commit real credentials.
INITIAL_OWNER_EMAIL=
INITIAL_OWNER_PASSWORD=

# Starting credit balance granted to the owner on first bootstrap.
# The owner must hold at least 1 credit to use the dashboard (see
# lib/auth/credits.ts). Defaults to 100 when unset.
INITIAL_OWNER_CREDITS=100

# --- Optional: Owner credits top-up API ---
# POST /api/internal/owner-credits — sets or increments the owner's credit
# balance. Sent as `Authorization: Bearer <key>`. Leave blank to disable
# the endpoint entirely (it then always returns 503).
OWNER_CREDITS_API_KEY=

# --- Optional: Email (password reset, order emails) ---
# If unset, email features degrade gracefully and the UI says so honestly.
# Resend (https://resend.com) is a simple choice. Leave blank to disable.
RESEND_API_KEY=
EMAIL_FROM="DailyNest <orders@dailynest.example>"

# --- Optional: Web Push (owner new-order alerts) ---
# Generate with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:owner@dailynest.example
